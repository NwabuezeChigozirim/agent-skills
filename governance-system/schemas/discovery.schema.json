{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/governance/discovery.schema.json",
  "title": "Governance Discovery Packet",
  "type": "object",
  "required": [
    "schema_version",
    "repository_id",
    "mode",
    "canonical_worktree",
    "canonical_head",
    "worktree_summary",
    "observations",
    "hypotheses",
    "needs_owner",
    "blocking_items",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "repository_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["greenfield", "brownfield", "mixed"] },
    "canonical_worktree": { "type": "string", "minLength": 1 },
    "canonical_head": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "intent_sources_present": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "worktree_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "head", "dirty", "dirty_paths"],
        "properties": {
          "path": { "type": "string" },
          "branch": { "type": "string" },
          "head": { "type": "string" },
          "dirty": { "type": "boolean" },
          "dirty_paths": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "observations": { "type": "array", "items": { "$ref": "#/$defs/note" } },
    "hypotheses": { "type": "array", "items": { "$ref": "#/$defs/note" } },
    "needs_owner": { "type": "array", "items": { "$ref": "#/$defs/note" } },
    "blocking_items": { "type": "array", "items": { "$ref": "#/$defs/note" } },
    "generated_at": { "type": "string" }
  },
  "$defs": {
    "note": {
      "type": "object",
      "required": ["id", "kind", "text", "provenance", "evidence_class", "created_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^N-\\d{3,}$" },
        "kind": { "enum": ["observation", "hypothesis", "needs-owner", "blocking"] },
        "text": { "type": "string", "minLength": 1 },
        "evidence": { "type": ["string", "null"] },
        "provenance": {
          "enum": ["code", "test", "ci", "git", "owner", "hypothesis", "needs-owner"]
        },
        "evidence_class": {
          "enum": [
            "fact",
            "observed-behavior",
            "stakeholder-requirement",
            "domain-constraint",
            "accepted-decision",
            "hypothesis",
            "assumption",
            "preference",
            "aesthetic-choice"
          ]
        },
        "created_at": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}
