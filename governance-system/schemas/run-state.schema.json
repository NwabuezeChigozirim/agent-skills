{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/governance/run-state.schema.json",
  "title": "Governance run state",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "repository_id",
    "status",
    "phase",
    "canonical_worktree",
    "canonical_branch",
    "canonical_head",
    "next_action"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "run_id": { "type": "string", "minLength": 1 },
    "repository_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "closed"] },
    "phase": {
      "enum": [
        "discovery",
        "resolution",
        "intent",
        "specification",
        "planning",
        "operations",
        "validation",
        "handoff"
      ]
    },
    "canonical_worktree": { "type": "string", "minLength": 1 },
    "canonical_branch": { "type": "string", "minLength": 1 },
    "canonical_head": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "next_action": { "type": "string", "minLength": 1 },
    "owner_close_approved": { "type": "boolean" },
    "started_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "closed_at": { "type": "string" },
    "stage_required": { "type": "boolean" },
    "stage_id": { "type": "string", "pattern": "^ST-[0-9a-f]{32}$" },
    "stage_contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stage_history": { "type": "array", "items": { "type": "object" } },
    "stage_completion": {
      "type": "object",
      "required": ["stage_id", "contract_sha256", "subject", "evidence", "owner_approval", "closed_at"],
      "properties": {
        "stage_id": { "type": "string", "pattern": "^ST-[0-9a-f]{32}$" },
        "contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "subject": { "type": "object" },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "owner_approval": { "type": "object" },
        "closed_at": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}
