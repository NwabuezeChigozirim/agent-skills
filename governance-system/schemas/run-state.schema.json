{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/governance/run-state.schema.json",
  "title": "Governance run state",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "repository_id",
    "status",
    "phase",
    "canonical_worktree",
    "canonical_branch",
    "canonical_head",
    "next_action"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "run_id": { "type": "string", "minLength": 1 },
    "repository_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "closed"] },
    "phase": {
      "enum": [
        "discovery",
        "resolution",
        "intent",
        "specification",
        "planning",
        "operations",
        "validation",
        "handoff"
      ]
    },
    "canonical_worktree": { "type": "string", "minLength": 1 },
    "canonical_branch": { "type": "string", "minLength": 1 },
    "canonical_head": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "next_action": { "type": "string", "minLength": 1 },
    "owner_close_approved": { "type": "boolean" },
    "started_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "closed_at": { "type": "string" }
  },
  "additionalProperties": true
}
