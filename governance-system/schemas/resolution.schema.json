{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/governance/resolution.schema.json",
  "title": "Governance worktree resolutions",
  "type": "object",
  "required": ["schema_version", "repository_id", "records", "updated_at"],
  "properties": {
    "schema_version": { "const": 3 },
    "repository_id": { "type": "string", "minLength": 1 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "key",
          "kind",
          "worktrees",
          "paths",
          "status",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^R-[0-9]{3,}$" },
          "key": { "type": "string", "minLength": 32 },
          "kind": { "enum": ["overlapping-paths", "divergent-base", "unfinished-variant", "incomplete-recovery", "unavailable-worktree"] },
          "worktrees": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "paths": { "type": "array", "items": { "type": "string" } },
          "snapshots": { "type": "array" },
          "scope_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "review_fingerprint": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "retired_at": { "type": "string" },
          "supersedes": { "type": "array", "items": { "type": "string", "pattern": "^R-[0-9]{3,}$" } },
          "superseded_by": { "type": "array", "items": { "type": "string", "pattern": "^R-[0-9]{3,}$" } },
          "decision_history": { "type": "array", "items": { "type": "object" } },
          "coverage_snapshot": { "type": "string" },
          "recovery_gaps": { "type": "array", "items": { "type": "object" } },
          "recovery_refs": { "type": "array", "items": { "type": "string", "pattern": "^refs/governance/snapshots/[0-9a-f]{40,64}$" } },
          "alternative_recovery": {
            "type": "object",
            "required": ["path", "sha256", "size", "coverage_authority"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "size": { "type": "integer", "minimum": 1 },
              "coverage_authority": { "const": "owner-attested" }
            }
          },
          "choice": {
            "enum": [
              "keep-canonical",
              "adopt",
              "combine",
              "defer",
              "obsolete",
              "return-to-agent",
              null
            ]
          },
          "note": { "type": ["string", "null"] },
          "head": { "type": ["string", "null"] },
          "branch": { "type": ["string", "null"] },
          "ahead": { "type": ["integer", "null"] },
          "behind": { "type": ["integer", "null"] },
          "status": { "enum": ["needs-owner", "pending", "resolved", "deferred", "obsolete"] }
        }
      }
    },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": true
}
