{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/governance/stage-contract.schema.json",
  "title": "Explicit stage acceptance contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "scope", "inputs", "outputs", "acceptance", "checks"],
  "properties": {
    "version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "inputs": {"$ref": "#/$defs/paths"},
    "outputs": {"$ref": "#/$defs/paths"},
    "acceptance": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "description", "checks"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC-[0-9]{3,}$"},
          "description": {"type": "string", "minLength": 1},
          "checks": {"type": "array", "minItems": 1, "uniqueItems": true,
                     "items": {"type": "string", "pattern": "^CHK-[0-9]{3,}$"}}
        }
      }
    },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "argv", "timeout_seconds"],
        "properties": {
          "id": {"type": "string", "pattern": "^CHK-[0-9]{3,}$"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
        }
      }
    }
  },
  "$defs": {
    "paths": {"type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}}
  }
}
