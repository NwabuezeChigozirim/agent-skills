#!/usr/bin/env python3
"""Deterministic governance runtime for local Git worktrees."""

from __future__ import annotations

import argparse
import contextlib
import datetime as dt
import fcntl
import hashlib
import gzip
import io
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
from typing import Any, Iterator

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
import engineering_policy as policy  # noqa: E402
import stage_contracts as stages  # noqa: E402


SCHEMA_VERSION = 3
LEGACY_SCHEMA_VERSIONS = {2}
SUITE_VERSION = "2.1.0"
EXIT_USAGE = 2
EXIT_VALIDATION = 3
EXIT_GATE = 4
EXIT_UNSAFE = 5
MAX_SNAPSHOT_BYTES = 200 * 1024 * 1024
SENSITIVE_NAMES = {
    ".env",
    ".env.local",
    ".env.production",
    "credentials.json",
    "secrets.json",
    "id_rsa",
    "id_ed25519",
}


class GovernanceError(RuntimeError):
    def __init__(self, message: str, exit_code: int = 1):
        super().__init__(message)
        self.exit_code = exit_code


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat()


def run_process(
    command: list[str],
    cwd: Path,
    *,
    check: bool = True,
    text: bool = True,
) -> subprocess.CompletedProcess[Any]:
    result = subprocess.run(
        command,
        cwd=str(cwd),
        check=False,
        capture_output=True,
        text=text,
        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
    )
    if check and result.returncode != 0:
        stderr = result.stderr.strip() if text else result.stderr.decode(errors="replace").strip()
        raise GovernanceError(
            f"Command failed ({result.returncode}): {' '.join(command)}"
            + (f": {stderr}" if stderr else ""),
            EXIT_VALIDATION,
        )
    return result


def git(repo: Path, *args: str, check: bool = True) -> str:
    result = run_process(["git", "--no-optional-locks", *args], repo, check=check, text=True)
    return result.stdout.strip()


def git_bytes(repo: Path, *args: str, check: bool = True) -> bytes:
    result = run_process(["git", "--no-optional-locks", *args], repo, check=check, text=False)
    return result.stdout


def resolve_repo(value: str) -> Path:
    repo = Path(value).expanduser().resolve()
    if not repo.is_dir():
        raise GovernanceError(f"Repository path does not exist: {repo}", EXIT_USAGE)
    if git(repo, "rev-parse", "--is-inside-work-tree", check=False) != "true":
        raise GovernanceError(f"Not a Git worktree: {repo}", EXIT_USAGE)
    return repo


def repository_root(repo: Path) -> Path:
    return Path(git(repo, "rev-parse", "--show-toplevel")).resolve()


def common_git_dir(repo: Path) -> Path:
    raw = Path(git(repo, "rev-parse", "--git-common-dir"))
    if not raw.is_absolute():
        raw = repository_root(repo) / raw
    return raw.resolve()


def state_dir(repo: Path) -> Path:
    return common_git_dir(repo) / "governance"


def config_path(repo: Path) -> Path:
    return repository_root(repo) / ".governance" / "config.json"


def state_path(repo: Path, name: str) -> Path:
    return state_dir(repo) / name


def read_json(path: Path, default: Any = None) -> Any:
    if not path.exists():
        return default
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise GovernanceError(f"Malformed governance JSON: {path}: {exc}", EXIT_VALIDATION)
    if not isinstance(value, dict):
        raise GovernanceError(f"Governance JSON must be an object: {path}", EXIT_VALIDATION)
    return value


def atomic_write_json(path: Path, value: Any, *, mode: int = 0o600) -> None:
    atomic_write_bytes(path, (json.dumps(value, indent=2, sort_keys=True) + "\n").encode(), mode=mode)


def atomic_write_bytes(path: Path, payload: bytes, *, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_name, path)
    finally:
        if os.path.exists(temp_name):
            os.unlink(temp_name)


@contextlib.contextmanager
def state_lock(repo: Path) -> Iterator[None]:
    directory = state_dir(repo)
    directory.mkdir(parents=True, exist_ok=True)
    lock_path = directory / "runtime.lock"
    with lock_path.open("a+", encoding="utf-8") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def branch_name(repo: Path) -> str:
    branch = git(repo, "symbolic-ref", "--quiet", "--short", "HEAD", check=False)
    return branch or "(detached)"


def current_head(repo: Path) -> str:
    return git(repo, "rev-parse", "HEAD")


def repo_identity(repo: Path) -> str:
    # Root commits are identical in every clone and worktree, unlike filesystem paths,
    # so a committed config keeps working after a clone or a move.
    roots = git(repo, "rev-list", "--max-parents=0", "HEAD", check=False)
    if not roots:
        raise GovernanceError(
            "Repository has no commits; create an initial commit before enabling governance",
            EXIT_USAGE,
        )
    joined = "\n".join(sorted(roots.split()))
    return hashlib.sha256(joined.encode("utf-8")).hexdigest()[:20]


def main_worktree(repo: Path) -> Path:
    records = parse_worktrees(repo)
    if not records:
        return repository_root(repo)
    return Path(records[0]["path"])


def canonical_state_path(repo: Path) -> Path:
    return state_path(repo, "canonical.json")


def load_canonical(repo: Path) -> dict[str, Any]:
    """Read the selection or derive its default without persisting it."""
    stored = read_json(canonical_state_path(repo))
    if stored is not None and (
        not isinstance(stored.get("canonical_worktree"), str) or not stored["canonical_worktree"].strip()
    ):
        raise GovernanceError("Canonical state requires a canonical_worktree path", EXIT_VALIDATION)
    if stored is None:
        default = main_worktree(repo)
        selected_by = "default-main-worktree"
        config = load_config(repo)
        if config and config["schema_version"] in LEGACY_SCHEMA_VERSIONS:
            previous = config.get("canonical_worktree")
            if previous:
                candidate = Path(previous).expanduser().resolve()
                listed = {Path(item["path"]) for item in parse_worktrees(repo)}
                if candidate.is_dir() and candidate in listed:
                    default = candidate
                    selected_by = "legacy-config"
        stored = {
            "schema_version": SCHEMA_VERSION,
            "canonical_worktree": str(default),
            "canonical_branch": branch_name(default),
            "selected_by": selected_by,
            "updated_at": utc_now(),
        }
    return stored


def initialize_canonical(repo: Path) -> None:
    """Only explicit state-changing operations may materialize the default."""
    if not canonical_state_path(repo).exists():
        atomic_write_json(canonical_state_path(repo), load_canonical(repo))


def save_canonical(repo: Path, worktree: Path, selected_by: str) -> dict[str, Any]:
    record = {
        "schema_version": SCHEMA_VERSION,
        "canonical_worktree": str(worktree),
        "canonical_branch": branch_name(worktree),
        "selected_by": selected_by,
        "updated_at": utc_now(),
    }
    atomic_write_json(canonical_state_path(repo), record)
    return record


def parse_worktrees(repo: Path) -> list[dict[str, Any]]:
    records: list[dict[str, Any]] = []
    current: dict[str, Any] = {}
    output = git(repo, "worktree", "list", "--porcelain")
    for line in output.splitlines() + [""]:
        if not line:
            if current:
                current["path"] = str(Path(current["path"]).resolve())
                records.append(current)
                current = {}
            continue
        key, _, value = line.partition(" ")
        if key == "worktree":
            current["path"] = value
        elif key == "HEAD":
            current["head"] = value
        elif key == "branch":
            current["branch"] = value.removeprefix("refs/heads/")
        elif key in {"detached", "bare", "locked", "prunable"}:
            current[key] = value or True
    return records


def parse_status(worktree: Path) -> dict[str, Any]:
    raw = git_bytes(
        worktree,
        "status",
        "--porcelain=v1",
        "-z",
        "--untracked-files=all",
    )
    tokens = raw.decode("utf-8", errors="surrogateescape").split("\0")
    staged: set[str] = set()
    unstaged: set[str] = set()
    untracked: set[str] = set()
    all_paths: set[str] = set()
    index = 0
    while index < len(tokens):
        token = tokens[index]
        index += 1
        if not token:
            continue
        if len(token) < 4:
            continue
        status = token[:2]
        path = token[3:]
        if any(flag in status for flag in "RC") and index < len(tokens):
            original = tokens[index]
            index += 1
            if original:
                all_paths.add(original)
        all_paths.add(path)
        if status == "??":
            untracked.add(path)
        else:
            if status[0] != " ":
                staged.add(path)
            if status[1] != " ":
                unstaged.add(path)
    return {
        "staged": sorted(staged),
        "unstaged": sorted(unstaged),
        "untracked": sorted(untracked),
        "dirty_paths": sorted(all_paths),
        "dirty": bool(all_paths),
    }


def fingerprint(value: Any) -> str:
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


@contextlib.contextmanager
def path_parent(root: Path, relative: str) -> Iterator[tuple[int, str]]:
    """Anchor each component; never follow a dirty path outside its worktree."""
    parts = Path(relative).parts
    if not parts or Path(relative).is_absolute() or ".." in parts:
        raise OSError("Unsafe worktree-relative path")
    fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for part in parts[:-1]:
            next_fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = next_fd
        yield fd, parts[-1]
    finally:
        os.close(fd)


def file_state(root: Path, relative: str, *, capture_limit: int | None = None) -> tuple[dict[str, Any], bytes | None]:
    """Hash raw bytes, not filtered Git content. Capture only within the supplied budget."""
    try:
        with path_parent(root, relative) as (parent, leaf):
            info = os.stat(leaf, dir_fd=parent, follow_symlinks=False)
            mode = stat.S_IMODE(info.st_mode)
            if stat.S_ISLNK(info.st_mode):
                target = os.fsencode(os.readlink(leaf, dir_fd=parent))
                return {"kind": "symlink", "mode": mode, "size": len(target),
                        "sha256": hashlib.sha256(target).hexdigest()}, target
            if not stat.S_ISREG(info.st_mode):
                return {"kind": "unsupported", "mode": mode}, None
            fd = os.open(leaf, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
            with os.fdopen(fd, "rb") as handle:
                opened = os.fstat(handle.fileno())
                if not stat.S_ISREG(opened.st_mode):
                    return {"kind": "unsupported"}, None
                digest = hashlib.sha256()
                chunks = [] if capture_limit is not None and opened.st_size <= capture_limit else None
                size = 0
                for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                    digest.update(chunk)
                    size += len(chunk)
                    if chunks is not None:
                        if size <= capture_limit:
                            chunks.append(chunk)
                        else:
                            chunks = None
                return {"kind": "file", "mode": stat.S_IMODE(opened.st_mode), "size": size,
                        "sha256": digest.hexdigest()}, b"".join(chunks) if chunks is not None else None
    except FileNotFoundError:
        return {"kind": "deleted"}, None
    except OSError:
        return {"kind": "unreadable"}, None


def scan_worktree(root: Path) -> dict[str, Any]:
    status = parse_status(root)
    entries = []
    for token in git_bytes(root, "ls-files", "--stage", "-z").split(b"\0"):
        if token:
            header, path = token.split(b"\t", 1)
            mode, oid, stage = header.decode("ascii").split()
            entries.append({"path": os.fsdecode(path), "mode": mode, "oid": oid, "stage": int(stage)})
    files = {path: file_state(root, path)[0] for path in status["dirty_paths"]}
    state = {**status, "head": current_head(root), "index_entries": entries, "files": files}
    return {**state, "availability": "available", "content_fingerprint": fingerprint(state),
            "content_verifiable": all(value["kind"] in {"file", "symlink", "deleted"} for value in files.values()),
            "hashes": {path: value.get("sha256", value["kind"]) for path, value in files.items()}}


def divergence(canonical: Path, canonical_head: str, other: Path, other_head: str) -> dict[str, Any]:
    if canonical_head == other_head:
        return {"ahead": 0, "behind": 0, "diverged": False}
    raw = git(canonical, "rev-list", "--left-right", "--count", f"{canonical_head}...{other_head}", check=False)
    match = re.fullmatch(r"(\d+)\s+(\d+)", raw)
    if not match:
        return {"ahead": None, "behind": None, "diverged": True}
    canonical_only, other_only = int(match.group(1)), int(match.group(2))
    return {
        "ahead": other_only,
        "behind": canonical_only,
        "diverged": canonical_only > 0 and other_only > 0,
    }


def load_config(repo: Path, *, required: bool = False) -> dict[str, Any] | None:
    config = read_json(config_path(repo))
    if config is None and required:
        raise GovernanceError(
            "Governance is not initialized; .governance/config.json is missing",
            EXIT_VALIDATION,
        )
    if config is not None:
        version = config.get("schema_version")
        if type(version) is not int or version not in LEGACY_SCHEMA_VERSIONS | {SCHEMA_VERSION}:
            raise GovernanceError("Unsupported governance config schema", EXIT_VALIDATION)
        try:
            policy.policy_version(config.get("policy_version", policy.LEGACY_POLICY))
        except ValueError as exc:
            raise GovernanceError(str(exc), EXIT_VALIDATION) from exc
        if version in LEGACY_SCHEMA_VERSIONS and config.get("canonical_worktree") is not None:
            if not isinstance(config["canonical_worktree"], str):
                raise GovernanceError("Legacy canonical_worktree must be a path string", EXIT_VALIDATION)
        # Schema 2 used machine paths as identity. Read it as legacy; only explicit
        # upgrade rewrites its identity or moves its canonical selection.
        if version == SCHEMA_VERSION and config.get("repository_id") != repo_identity(repo):
            raise GovernanceError("Governance config belongs to a different repository", EXIT_VALIDATION)
    return config


def default_project_slug(repo: Path) -> str:
    root = repository_root(repo)
    return re.sub(r"[^a-z0-9]+", "-", root.name.lower()).strip("-") or "project"


def ensure_config(repo: Path) -> dict[str, Any]:
    existing = load_config(repo)
    if existing is not None:
        return existing
    config = {
        "schema_version": SCHEMA_VERSION,
        "suite_version": SUITE_VERSION,
        "policy_version": policy.DEFAULT_POLICY,
        "repository_id": repo_identity(repo),
        "enabled": True,
        "hooks_enabled": False,
        "project_slug": default_project_slug(repo),
        "created_at": utc_now(),
    }
    atomic_write_json(config_path(repo), config, mode=0o644)
    return config


def canonical_repo(repo: Path) -> Path:
    record = load_canonical(repo)
    canonical = Path(record["canonical_worktree"]).expanduser().resolve()
    listed = {Path(item["path"]).resolve() for item in parse_worktrees(repo)}
    if canonical not in listed:
        raise GovernanceError(
            f"Configured canonical worktree is unavailable: {canonical}",
            EXIT_GATE,
        )
    return canonical


def inventory(repo: Path) -> dict[str, Any]:
    canonical = canonical_repo(repo)
    entries = parse_worktrees(repo)
    canonical_entry = next(entry for entry in entries if entry["path"] == str(canonical))
    items: list[dict[str, Any]] = []
    for entry in entries:
        worktree = Path(entry["path"])
        try:
            if entry.get("bare") or not worktree.is_dir():
                raise OSError("Worktree directory is unavailable")
            status = scan_worktree(worktree)
        except (OSError, GovernanceError) as exc:
            status = {
                "staged": [], "unstaged": [], "untracked": [], "dirty_paths": [],
                "dirty": None, "hashes": {}, "files": {}, "index_entries": [],
                "availability": "unavailable", "scan_error": str(exc),
                "content_fingerprint": fingerprint(["unavailable", entry["path"], entry.get("head")]),
            }
        item = {
            **entry,
            **status,
            "canonical": worktree.resolve() == canonical,
            "scanned_at": utc_now(),
        }
        items.append(item)
    canonical_item = next(item for item in items if item["canonical"])
    canonical_head = canonical_item["head"]
    for item in items:
        item["divergence"] = divergence(repo, canonical_head, Path(item["path"]), item["head"])
    return {
        "schema_version": SCHEMA_VERSION,
        "repository_id": repo_identity(repo),
        "canonical_worktree": str(canonical),
        "canonical_branch": canonical_entry.get("branch", "(detached)"),
        "canonical_head": canonical_head,
        "worktrees": items,
        "scanned_at": utc_now(),
    }


PHASES = [
    "discovery",
    "resolution",
    "intent",
    "specification",
    "planning",
    "operations",
    "validation",
    "handoff",
]
NOTE_KINDS = {
    "observation": "observations",
    "hypothesis": "hypotheses",
    "needs-owner": "needs_owner",
    "blocking": "blocking_items",
}
PROVENANCE = ["code", "test", "ci", "git", "owner", "hypothesis", "needs-owner"]
# Mirrors spec-chain/references/need-first.md §5; the class travels unchanged into
# DECISIONS.md and the CON.
EVIDENCE_CLASSES = [
    "fact",
    "observed-behavior",
    "stakeholder-requirement",
    "domain-constraint",
    "accepted-decision",
    "hypothesis",
    "assumption",
    "preference",
    "aesthetic-choice",
]


def start_or_refresh_run(repo: Path, registry: dict[str, Any]) -> dict[str, Any]:
    path = state_path(repo, "run-state.json")
    state = read_json(path, {})
    if not state or state.get("status") == "closed":
        state = {
            "schema_version": SCHEMA_VERSION,
            "run_id": dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ"),
            "repository_id": repo_identity(repo),
            "status": "active",
            "phase": "discovery",
            "started_at": utc_now(),
            "owner_close_approved": False,
            "next_action": "Review discovery evidence and resolve blocking worktree variants",
        }
    # Refreshes only track canonical state; phase and next_action belong to reconcile,
    # phase and close-stage so that hook-driven rediscovery never rewinds progress.
    state.update(
        {
            "canonical_worktree": registry["canonical_worktree"],
            "canonical_branch": registry["canonical_branch"],
            "canonical_head": registry["canonical_head"],
            "updated_at": utc_now(),
        }
    )
    atomic_write_json(path, state)
    return state


def discovery_notes(repo: Path) -> list[dict[str, Any]]:
    stored = read_json(state_path(repo, "discovery-notes.json"), {"notes": []})
    notes = stored.get("notes", []) if isinstance(stored, dict) else []
    return [item for item in notes if isinstance(item, dict)]


def command_note(
    repo: Path,
    kind: str,
    text: str,
    evidence: str | None,
    provenance: str | None,
    evidence_class: str | None = None,
) -> dict[str, Any]:
    if kind not in NOTE_KINDS:
        raise GovernanceError(f"Unsupported note kind: {kind}", EXIT_USAGE)
    if not text.strip():
        raise GovernanceError("Note text is required", EXIT_USAGE)
    if provenance is None:
        provenance = {"hypothesis": "hypothesis", "needs-owner": "needs-owner", "blocking": "needs-owner"}.get(kind, "code")
    if provenance not in PROVENANCE:
        raise GovernanceError(f"Unsupported provenance: {provenance}", EXIT_USAGE)
    if provenance in {"code", "test", "ci", "git"} and not (evidence or "").strip():
        raise GovernanceError(f"Provenance '{provenance}' requires --evidence (path, command or commit)", EXIT_USAGE)
    if evidence_class is None:
        # A hypothesis note is a hypothesis; anything read from the repository is observed
        # behavior of the current system until the owner classes it otherwise.
        evidence_class = "hypothesis" if kind == "hypothesis" else "observed-behavior" if provenance in {"code", "test", "ci", "git"} else "assumption"
    if evidence_class not in EVIDENCE_CLASSES:
        raise GovernanceError(f"Unsupported evidence class: {evidence_class}", EXIT_USAGE)
    with state_lock(repo):
        load_config(repo, required=True)
        path = state_path(repo, "discovery-notes.json")
        stored = read_json(path, {"schema_version": SCHEMA_VERSION, "notes": []})
        notes = stored.get("notes", [])
        used = {
            int(match.group(1))
            for item in notes
            if (match := re.fullmatch(r"N-(\d+)", str(item.get("id", ""))))
        }
        note = {
            "id": f"N-{max(used, default=0) + 1:03d}",
            "kind": kind,
            "text": text.strip(),
            "evidence": (evidence or "").strip() or None,
            "provenance": provenance,
            "evidence_class": evidence_class,
            "created_at": utc_now(),
        }
        notes.append(note)
        stored["notes"] = notes
        stored["schema_version"] = SCHEMA_VERSION
        stored["updated_at"] = utc_now()
        atomic_write_json(path, stored)
        registry = read_json(state_path(repo, "registry.json"))
        if registry is not None:
            atomic_write_json(state_path(repo, "discovery.json"), discovery_packet(repo, registry))
    return {
        "id": note["id"],
        "kind": kind,
        "provenance": provenance,
        "evidence_class": evidence_class,
        "notes_total": len(notes),
    }


def command_phase(repo: Path, phase: str, next_action: str | None) -> dict[str, Any]:
    if phase not in PHASES:
        raise GovernanceError(f"Unsupported phase: {phase}", EXIT_USAGE)
    with state_lock(repo):
        load_config(repo, required=True)
        path = state_path(repo, "run-state.json")
        run = read_json(path)
        if run is None or run.get("status") != "active":
            raise GovernanceError("No active governance run; run discover", EXIT_VALIDATION)
        run["phase"] = phase
        if next_action and next_action.strip():
            run["next_action"] = next_action.strip()
        run["updated_at"] = utc_now()
        atomic_write_json(path, run)
    return {"run_id": run.get("run_id"), "phase": phase, "next_action": run.get("next_action")}


def discovery_packet(repo: Path, registry: dict[str, Any]) -> dict[str, Any]:
    root = Path(registry["canonical_worktree"])
    intent_candidates = [
        "README.md",
        "AGENTS.md",
        "CLAUDE.md",
        "design.md",
        "DECISIONS.md",
        "docs",
    ]
    present = [name for name in intent_candidates if (root / name).exists()]
    source_suffixes = {".py", ".js", ".jsx", ".ts", ".tsx", ".go", ".rs", ".java", ".rb", ".php"}
    source_count = 0
    for candidate in root.rglob("*"):
        if ".git" in candidate.parts or not candidate.is_file():
            continue
        if candidate.suffix.lower() in source_suffixes:
            source_count += 1
            if source_count >= 20:
                break
    mode = "brownfield" if source_count else "greenfield"
    if source_count and any(name in present for name in {"design.md", "DECISIONS.md", "docs"}):
        mode = "mixed"
    grouped: dict[str, list[dict[str, Any]]] = {field: [] for field in NOTE_KINDS.values()}
    for note in discovery_notes(repo):
        field = NOTE_KINDS.get(str(note.get("kind")))
        if field:
            grouped[field].append(note)
    return {
        "schema_version": SCHEMA_VERSION,
        "repository_id": repo_identity(repo),
        "mode": mode,
        "canonical_worktree": registry["canonical_worktree"],
        "canonical_head": registry["canonical_head"],
        "intent_sources_present": present,
        "source_files_detected": source_count,
        "worktree_summary": [
            {
                "path": item["path"],
                "branch": item.get("branch", "(detached)"),
                "head": item.get("head"),
                "dirty": item["dirty"],
                "availability": item["availability"],
                "dirty_paths": item["dirty_paths"],
            }
            for item in registry["worktrees"]
        ],
        "observations": grouped["observations"],
        "hypotheses": grouped["hypotheses"],
        "needs_owner": grouped["needs_owner"],
        "blocking_items": grouped["blocking_items"],
        "generated_at": utc_now(),
    }


def is_sensitive_path(relative: str) -> bool:
    path = Path(relative)
    lowered = {part.lower() for part in path.parts}
    name = path.name.lower()
    return (
        name in SENSITIVE_NAMES
        or name.startswith(".env.")
        or "secrets" in lowered
        or "credentials" in lowered
        or ".ssh" in lowered
    )


def safe_snapshot_name(worktree: dict[str, Any]) -> str:
    path_hash = hashlib.sha256(worktree["path"].encode("utf-8")).hexdigest()[:10]
    version = fingerprint([2, worktree["content_fingerprint"], MAX_SNAPSHOT_BYTES])
    return f"v2-{path_hash}-{version}"


def recovery_ref(head: str) -> str:
    return f"refs/governance/snapshots/{head}"


def check_recovery_ref(repo: Path, head: str) -> bool:
    ref = recovery_ref(head)
    return (not git(repo, "symbolic-ref", "--quiet", ref, check=False)
            and git(repo, "rev-parse", "--verify", ref, check=False) == head
            and git(repo, "cat-file", "-t", head, check=False) == "commit")


def pin_head(repo: Path, head: str) -> str:
    """Create a retention ref, never update an existing ref or a user's branch."""
    ref = recovery_ref(head)
    if git(repo, "symbolic-ref", "--quiet", ref, check=False):
        raise GovernanceError(f"Refusing symbolic recovery ref: {ref}", EXIT_UNSAFE)
    if not check_recovery_ref(repo, head):
        if git(repo, "cat-file", "-t", head, check=False) != "commit":
            raise GovernanceError(f"Recovery base commit unavailable: {head}", EXIT_GATE)
        git(repo, "update-ref", "--no-deref", ref, head, "0" * len(head))
        if not check_recovery_ref(repo, head):
            raise GovernanceError(f"Cannot retain recovery base: {ref}", EXIT_GATE)
    return ref


def snapshot_errors(repo: Path, manifest: dict[str, Any]) -> list[str]:
    if manifest.get("snapshot_format") != 2:
        return ["Legacy snapshot has no verifiable recovery coverage; reconcile available work or provide a backup"]
    errors = []
    directory = state_dir(repo) / "snapshots"
    identifier = manifest.get("snapshot_id", "")
    payloads = manifest.get("payloads", {})
    if (not isinstance(identifier, str) or not re.fullmatch(r"v2-[0-9a-f]{10}-[0-9a-f]{64}", identifier)
            or not isinstance(manifest.get("head"), str) or not re.fullmatch(r"[0-9a-f]{40,64}", manifest["head"])
            or not isinstance(payloads, dict) or not all(isinstance(value, dict) for value in payloads.values())
            or not isinstance(manifest.get("files"), dict) or not isinstance(manifest.get("index_entries"), list)
            or not isinstance(manifest.get("coverage"), dict)
            or manifest["coverage"].get("status") not in {"complete", "incomplete"}
            or not isinstance(manifest["coverage"].get("gaps"), list)):
        return [f"Malformed recovery manifest: {identifier}"]
    if bool(manifest["coverage"]["gaps"]) != (manifest["coverage"]["status"] == "incomplete"):
        errors.append(f"Inconsistent recovery coverage: {identifier}")
    metadata = {key: value for key, value in manifest.items() if key != "manifest_fingerprint"}
    if manifest.get("manifest_fingerprint") != fingerprint(metadata):
        errors.append(f"Changed recovery metadata: {identifier}")
    if manifest.get("base_ref") != recovery_ref(manifest["head"]):
        errors.append(f"Inconsistent recovery base ref: {identifier}")
    expected = {f"{identifier}{suffix}" for suffix in (".patch", "-untracked.tar.gz", "-worktree.tar.gz", "-index.tar.gz")}
    if set(payloads) != expected:
        errors.append(f"Incomplete snapshot payload inventory: {identifier}")
    for name, digest in payloads.items():
        if name not in expected:
            continue
        actual, _ = file_state(directory, name)
        if actual.get("kind") != "file" or any(actual.get(key) != digest.get(key) for key in ("sha256", "size")):
            errors.append(f"Missing or changed recovery payload: {name}")
    if not check_recovery_ref(repo, manifest.get("head", "")):
        errors.append(f"Missing or changed recovery base: {identifier}")
    return errors


def publish_immutable(source: Path, target: Path) -> None:
    """Manifest-last, create-only publication; retries may reuse identical orphan payloads."""
    try:
        os.link(source, target)
    except FileExistsError:
        if file_state(source.parent, source.name)[0] != file_state(target.parent, target.name)[0]:
            raise GovernanceError(f"Refusing to overwrite recovery data: {target}", EXIT_UNSAFE)
    directory_fd = os.open(target.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


@contextlib.contextmanager
def snapshot_tar(path: Path) -> Iterator[tarfile.TarFile]:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as output:
        with gzip.GzipFile(filename="", mode="wb", fileobj=output, mtime=0) as compressed:
            with tarfile.open(fileobj=compressed, mode="w", format=tarfile.PAX_FORMAT) as archive:
                yield archive
        output.flush()
        os.fsync(output.fileno())


def add_snapshot_file(archive: tarfile.TarFile, name: str, state: dict[str, Any], data: bytes) -> None:
    info = tarfile.TarInfo(name)
    info.mode = state.get("mode", 0o600)
    if state["kind"] == "symlink":
        info.type = tarfile.SYMTYPE
        info.linkname = os.fsdecode(data)
        archive.addfile(info)
    else:
        info.size = len(data)
        archive.addfile(info, io.BytesIO(data))


def convenience_patch(root: Path) -> tuple[bytes, str]:
    """Bound optional diff output before allocating it; recovery does not depend on it."""
    command = ["git", "--no-optional-locks", "-c", "color.ui=false", "diff", "--no-ext-diff", "--no-textconv",
               "--no-renames", "--binary", "HEAD", "--"]
    with tempfile.TemporaryFile() as errors:
        with subprocess.Popen(command, cwd=root, stdout=subprocess.PIPE, stderr=errors) as process:
            assert process.stdout is not None
            data = process.stdout.read(MAX_SNAPSHOT_BYTES + 1)
            if len(data) > MAX_SNAPSHOT_BYTES:
                process.kill()
                process.communicate()
                return b"", "omitted-size-limit"
            process.wait()
            if process.returncode:
                return b"", "omitted-diff-unavailable"
    return data, "included"


def snapshot_worktree(repo: Path, worktree: dict[str, Any]) -> dict[str, Any]:
    root = Path(worktree["path"])
    snapshot_root = state_dir(repo) / "snapshots"
    if snapshot_root.is_symlink():
        raise GovernanceError("Snapshot directory must not be a symlink", EXIT_UNSAFE)
    snapshot_root.mkdir(parents=True, exist_ok=True, mode=0o700)
    identifier = safe_snapshot_name(worktree)
    manifest_path = snapshot_root / f"{identifier}.json"
    if manifest_path.is_symlink():
        raise GovernanceError("Snapshot manifest must not be a symlink", EXIT_UNSAFE)
    if manifest_path.exists():
        manifest = read_json(manifest_path)
        errors = snapshot_errors(repo, manifest)
        if manifest.get("snapshot_id") != identifier or manifest.get("content_fingerprint") != worktree["content_fingerprint"]:
            errors.append(f"Snapshot identity mismatch: {identifier}")
        if errors:
            raise GovernanceError("; ".join(errors), EXIT_GATE)
        return {**manifest, "_created": False}
    base_ref = pin_head(repo, worktree["head"])
    gaps: list[dict[str, str]] = []
    included: list[str] = []
    index_entries = [entry for entry in worktree["index_entries"] if entry["path"] in worktree["dirty_paths"]]
    names = {"tracked_patch": f"{identifier}.patch", "untracked_archive": f"{identifier}-untracked.tar.gz",
             "working_archive": f"{identifier}-worktree.tar.gz", "index_archive": f"{identifier}-index.tar.gz"}
    remaining = MAX_SNAPSHOT_BYTES
    with tempfile.TemporaryDirectory(prefix=".capture-", dir=snapshot_root) as temporary:
        staging = Path(temporary)
        with snapshot_tar(staging / names["working_archive"]) as tracked, snapshot_tar(staging / names["untracked_archive"]) as untracked:
            for relative in worktree["dirty_paths"]:
                expected = worktree["files"][relative]
                if is_sensitive_path(relative):
                    gaps.append({"path": relative, "reason": "excluded-sensitive"})
                    continue
                state, data = file_state(root, relative, capture_limit=remaining)
                if state != expected:
                    raise GovernanceError(f"Worktree changed during recovery capture: {root}; reconcile again", EXIT_GATE)
                if state["kind"] == "deleted":
                    continue
                if data is None or len(data) > remaining:
                    gaps.append({"path": relative, "reason": state["kind"] if state["kind"] not in {"file", "symlink"} else "size-limit"})
                    continue
                archive = untracked if relative in worktree["untracked"] else tracked
                add_snapshot_file(archive, relative, state, data)
                remaining -= len(data)
                if relative in worktree["untracked"]:
                    included.append(relative)
        captured_oids = set()
        with snapshot_tar(staging / names["index_archive"]) as archive:
            for entry in index_entries:
                relative, oid = entry["path"], entry["oid"]
                if is_sensitive_path(relative):
                    continue  # Already reported; do not copy staged secrets either.
                if entry["mode"] not in {"100644", "100755", "120000"} or set(oid) == {"0"}:
                    gaps.append({"path": relative, "reason": "unsupported-index-entry"})
                    continue
                if oid in captured_oids:
                    continue
                size = git(root, "cat-file", "-s", oid, check=False)
                if not size.isdigit() or int(size) > remaining:
                    gaps.append({"path": relative, "reason": "index-unavailable-or-size-limit"})
                    continue
                data = git_bytes(root, "cat-file", "blob", oid)
                add_snapshot_file(archive, f"objects/{oid}", {"kind": "file", "mode": 0o600}, data)
                captured_oids.add(oid)
                remaining -= len(data)
        # Convenience only. Raw working/index archives, not this net diff, define recovery.
        # Skip the diff entirely for incomplete captures (including sensitive renames).
        patch = b""
        patch_status = "omitted-incomplete-capture"
        if not gaps:
            patch, patch_status = convenience_patch(root)
        atomic_write_bytes(staging / names["tracked_patch"], patch)
        if scan_worktree(root)["content_fingerprint"] != worktree["content_fingerprint"]:
            raise GovernanceError(f"Worktree changed during recovery capture: {root}; reconcile again", EXIT_GATE)
        manifest = {
            "schema_version": SCHEMA_VERSION, "snapshot_format": 2, "snapshot_id": identifier,
            "content_fingerprint": worktree["content_fingerprint"], "capture_limit_bytes": MAX_SNAPSHOT_BYTES,
            "worktree": worktree["path"], "branch": worktree.get("branch", "(detached)"),
            "head": worktree["head"], "base_ref": base_ref, "dirty_paths": worktree["dirty_paths"],
            "files": worktree["files"], "index_entries": index_entries, "index_objects": sorted(captured_oids),
            **{key: str(snapshot_root / name) for key, name in names.items()},
            "patch_status": patch_status, "untracked_included": included,
            "untracked_excluded_sensitive": [p for p in worktree["untracked"] if is_sensitive_path(p)],
            "untracked_skipped": [g["path"] for g in gaps if g["path"] in worktree["untracked"]],
            "coverage": {"status": "incomplete" if gaps else "complete", "gaps": gaps},
            "payloads": {name: {key: file_state(staging, name)[0][key] for key in ("sha256", "size")} for name in names.values()},
            "created_at": utc_now(),
        }
        manifest["manifest_fingerprint"] = fingerprint(manifest)
        for name in names.values():
            publish_immutable(staging / name, snapshot_root / name)
        atomic_write_json(staging / manifest_path.name, manifest)
        publish_immutable(staging / manifest_path.name, manifest_path)
    return {**manifest, "_created": True}


def resolution_version(record: dict[str, Any], registry: dict[str, Any]) -> str | None:
    items = {item["path"]: item for item in registry["worktrees"]}
    names = record["worktrees"]
    if any(name not in items or items[name]["availability"] != "available" for name in names):
        return None
    kind = record["kind"]
    if kind == "overlapping-paths":
        paths = record["paths"]
        # Only the shared paths are under this review, not unrelated local work.
        return fingerprint([[name, items[name]["head"],
                             {p: items[name]["files"].get(p) for p in paths},
                             [e for e in items[name]["index_entries"] if e["path"] in paths]] for name in sorted(names)])
    if kind == "divergent-base":
        return fingerprint([registry["canonical_head"], items[names[-1]]["head"]])
    if kind == "unfinished-variant":
        return fingerprint([registry["canonical_head"], items[names[-1]]["content_fingerprint"]])
    if kind == "incomplete-recovery":
        return items[names[0]]["content_fingerprint"]
    return None


def proposed_resolutions(registry: dict[str, Any], snapshots: dict[str, dict[str, Any]]) -> list[dict[str, Any]]:
    proposed: list[dict[str, Any]] = []
    worktrees = registry["worktrees"]
    canonical = next(item for item in worktrees if item["canonical"])

    def add(kind: str, items: list[dict[str, Any]], paths: list[str], recommendation: str, **extra: Any) -> None:
        names = [item["path"] for item in items]
        record = {"kind": kind, "worktrees": names, "paths": paths, "recommendation": recommendation,
                  "snapshots": [snapshots[name]["snapshot_id"] for name in names if name in snapshots], **extra}
        version = resolution_version(record, registry)
        if kind == "unavailable-worktree":
            version = fingerprint([names, items[0].get("head"), "unavailable"])
        record["review_fingerprint"] = version
        record["scope_key"] = fingerprint([kind, sorted(names)])
        record["key"] = fingerprint([record["scope_key"], paths, version, record.get("coverage_snapshot")])
        proposed.append(record)

    for left_index, left in enumerate(worktrees):
        for right in worktrees[left_index + 1:]:
            overlap = sorted(set(left["dirty_paths"]).intersection(right["dirty_paths"]))
            if overlap:
                add("overlapping-paths", [left, right], overlap, "Review both captured versions and choose a disposition")
    for item in worktrees:
        if item["availability"] != "available":
            add("unavailable-worktree", [item], [], "Restore access and reconcile; unknown work cannot be waived")
            continue
        if not item.get("content_verifiable", True):
            add("unavailable-worktree", [item], item["dirty_paths"],
                "Current dirty content cannot be fingerprinted; restore readable supported files and reconcile. A backup alone cannot establish the current version")
        snapshot = snapshots.get(item["path"])
        if snapshot and snapshot["coverage"]["status"] != "complete":
            add("incomplete-recovery", [item], item["dirty_paths"],
                "Supply an owner-attested alternative backup for the uncovered content before closure",
                snapshots=[snapshot["snapshot_id"]], coverage_snapshot=snapshot["snapshot_id"],
                recovery_gaps=snapshot["coverage"]["gaps"])
        if item["canonical"]:
            continue
        if item["dirty"]:
            add("unfinished-variant", [canonical, item], item["dirty_paths"],
                "Integrate, defer, obsolete, or return this captured variant before stage closure",
                snapshots=[snapshot["snapshot_id"]] if snapshot else [])
        ahead = item["divergence"].get("ahead")
        if ahead is None or ahead > 0:
            add("divergent-base", [canonical, item], [],
                "Review committed work against canonical intent; commits are retained locally, not integrated",
                snapshots=[], head=item["head"], branch=item.get("branch", "(detached)"), ahead=ahead,
                behind=item["divergence"].get("behind"), recovery_refs=[recovery_ref(item["head"])])
    return proposed


def build_resolutions(
    repo: Path,
    registry: dict[str, Any],
    snapshots: dict[str, dict[str, Any]],
) -> dict[str, Any]:
    path = state_path(repo, "resolutions.json")
    previous = read_json(path, {"records": []})
    previous_by_key = {item["key"]: item for item in previous.get("records", [])
                       if not item.get("retired_at") and item.get("review_fingerprint")}
    used_ids = {
        int(match.group(1))
        for item in previous.get("records", [])
        if (match := re.fullmatch(r"R-(\d+)", str(item.get("id", ""))))
    }
    next_id = max(used_ids, default=0) + 1
    proposed = []
    candidates = proposed_resolutions(registry, snapshots)
    # Legacy net patches did not record staged content or coverage. Preserve their
    # bytes and decisions, but do not silently certify them under the new contract.
    for manifest_path in sorted((state_dir(repo) / "snapshots").glob("*.json")):
        legacy = read_json(manifest_path)
        if legacy.get("snapshot_format") == 2:
            continue
        identifier = legacy.get("snapshot_id", manifest_path.stem)
        names = [legacy.get("worktree", registry["canonical_worktree"])]
        version = fingerprint(legacy)
        scope = fingerprint(["incomplete-recovery", names])
        candidates.append({"kind": "incomplete-recovery", "worktrees": names, "paths": legacy.get("dirty_paths", []),
                           "snapshots": [identifier], "coverage_snapshot": identifier, "review_fingerprint": version,
                           "scope_key": scope, "key": fingerprint([scope, version, identifier]),
                           "recovery_gaps": [{"path": "(legacy snapshot)", "reason": "unverifiable-legacy-coverage"}],
                           "recommendation": "Preserved legacy snapshot lacks staged-state coverage; identify an owner-attested backup"})
    for candidate in candidates:
        if candidate["key"] in previous_by_key:
            # Keep the original review, including its snapshots and decision timestamps.
            proposed.append(dict(previous_by_key[candidate["key"]]))
        else:
            proposed.append({**candidate, "id": f"R-{next_id:03d}", "choice": None, "note": None,
                             "status": "needs-owner", "created_at": utc_now(), "updated_at": utc_now()})
            next_id += 1
    retained = {item["id"] for item in proposed}
    current_proposals = list(proposed)
    available = {item["path"] for item in registry["worktrees"] if item["availability"] == "available"}
    for old in previous.get("records", []):
        if old["id"] in retained:
            continue
        carried = dict(old)
        if not old.get("retired_at"):
            replacements = [new for new in current_proposals if new.get("scope_key") == old.get("scope_key")
                            or (old["kind"] in {"unfinished-variant", "divergent-base"}
                                and new["kind"] in {"unfinished-variant", "divergent-base", "unavailable-worktree"}
                                and old["worktrees"][-1] == new["worktrees"][-1])
                            or (not old.get("review_fingerprint") and old["kind"] == new["kind"]
                                and old["worktrees"] == new["worktrees"])]
            carried["retired_at"] = utc_now()
            carried["superseded_by"] = [new["id"] for new in replacements]
            for new in replacements:
                new.setdefault("supersedes", []).append(old["id"])
            # An uncovered historical version stays a recovery obligation, even after deletion.
            # Never interpret a changed key, unavailable tree, or unversioned legacy record as completed work.
            gone = not replacements and all(name in available for name in old["worktrees"])
            if gone and old.get("review_fingerprint") and old["kind"] != "incomplete-recovery":
                if carried.get("status") in {"pending", "needs-owner"}:
                    carried["status"] = "resolved"
                    carried["resolved_at"] = utc_now()
                    carried["note"] = ((carried.get("note") or "") + " | variant no longer present at reconcile").strip(" |")
            carried["updated_at"] = utc_now()
        proposed.append(carried)
    proposed.sort(key=lambda item: item["id"])
    result = {
        "schema_version": SCHEMA_VERSION,
        "repository_id": repo_identity(repo),
        "records": proposed,
        "updated_at": utc_now(),
    }
    atomic_write_json(path, result)
    return result


def unresolved_records(repo: Path) -> list[dict[str, Any]]:
    resolutions = read_json(state_path(repo, "resolutions.json"), {"records": []})
    return [
        item
        for item in resolutions.get("records", [])
        if (not item.get("retired_at") or item["kind"] == "incomplete-recovery")
        and item.get("status") not in {"resolved", "deferred", "obsolete"}
    ]


def alternative_recovery(repo: Path, value: str) -> dict[str, Any]:
    backup = Path(value).expanduser().absolute()
    backup = backup.parent.resolve() / backup.name
    for item in parse_worktrees(repo):
        if backup.resolve().is_relative_to(Path(item["path"]).resolve()):
            raise GovernanceError("Alternative backup must be outside registered worktrees", EXIT_GATE)
    state, _ = file_state(Path(backup.anchor), str(backup.relative_to(backup.anchor)))
    if state.get("kind") != "file" or not state.get("size"):
        raise GovernanceError("Alternative recovery requires an available, nonempty regular backup file (no symlinks)", EXIT_GATE)
    return {"path": str(backup), "sha256": state["sha256"], "size": state["size"], "coverage_authority": "owner-attested"}


def recovery_errors(repo: Path) -> list[str]:
    errors = []
    resolutions = read_json(state_path(repo, "resolutions.json"), {"records": []})
    # Historical recovery evidence remains accountable; decisions never authorize deleting it.
    for manifest_path in sorted((state_dir(repo) / "snapshots").glob("v2-*.json")):
        if manifest_path.is_symlink():
            errors.append(f"Snapshot manifest must not be a symlink: {manifest_path.name}")
            continue
        manifest = read_json(manifest_path)
        errors.extend(snapshot_errors(repo, manifest))
    for record in resolutions["records"]:
        if record["kind"] == "incomplete-recovery" and record.get("status") in {"resolved", "deferred", "obsolete"}:
            reference = record.get("alternative_recovery")
            try:
                actual = alternative_recovery(repo, reference["path"]) if reference else None
            except (GovernanceError, OSError):
                actual = None
            if not reference or actual != reference:
                errors.append(f"Missing or changed alternative recovery for {record['id']}")
        if record["kind"] == "divergent-base" and record.get("review_fingerprint"):
            if not check_recovery_ref(repo, record["head"]):
                errors.append(f"Missing recovery commit for {record['id']}")
        for identifier in record.get("snapshots", []):
            if identifier and identifier.startswith("v2-") and not (state_dir(repo) / "snapshots" / f"{identifier}.json").is_file():
                errors.append(f"Missing snapshot manifest for {record['id']}: {identifier}")
    return errors


def capture_inventory(repo: Path, registry: dict[str, Any]) -> dict[str, dict[str, Any]]:
    snapshots = {}
    for item in registry["worktrees"]:
        if item["availability"] != "available":
            continue
        if item["dirty"]:
            snapshots[item["path"]] = snapshot_worktree(repo, item)
        if not item["canonical"] and item["divergence"].get("ahead") != 0:
            pin_head(repo, item["head"])
    registry["snapshot_ids"] = [snapshot["snapshot_id"] for snapshot in snapshots.values()]
    return snapshots


# Shared template-placeholder detector. Keep byte-identical with the copies in
# plan-waves-slices/scripts/validate_plan.py and spec-chain/scripts/validate_spec.py.
# Matches <Project Name>, <install-command>, <YYYY-MM-DD>, <N>; ignores HTML tags,
# generics such as Vec<T>, autolinks <https://...> and <user@host> addresses.
PLACEHOLDER_RE = re.compile(r"(?<!\w)<(?!\w+://)([A-Za-z][^<>\n@]{0,120})>")
HTML_TAGS = {
    "a", "abbr", "b", "blockquote", "br", "code", "dd", "del", "details", "div", "dl", "dt", "em",
    "figcaption", "figure", "h1", "h2", "h3", "h4", "h5", "h6", "hr", "i", "img", "ins", "kbd", "li",
    "mark", "ol", "p", "pre", "s", "samp", "small", "span", "strong", "sub", "summary", "sup", "table",
    "tbody", "td", "tfoot", "th", "thead", "tr", "u", "ul", "var",
}


def find_placeholders(text: str) -> list[str]:
    found = {
        match.group(0)
        for match in PLACEHOLDER_RE.finditer(text)
        if match.group(1).split()[0].lower().rstrip("/") not in HTML_TAGS
    }
    return sorted(found)


def validate_generated_docs(root: Path) -> list[str]:
    errors: list[str] = []
    expected = [
        root / "AGENTS.md",
        root / "CLAUDE.md",
        root / "design.md",
        root / "DECISIONS.md",
        root / "Implementations.md",
        root / "README.md",
        root / "docs" / "waves" / "README.md",
    ]
    present_any = any(path.exists() for path in expected)
    if not present_any:
        return errors
    for path in expected:
        if not path.exists():
            errors.append(f"Missing governance artifact: {path.relative_to(root)}")
    scan = list(expected) + sorted((root / "docs" / "waves").glob("*.md"))
    seen: set[Path] = set()
    for path in scan:
        if path in seen or not path.is_file():
            continue
        seen.add(path)
        text = path.read_text(encoding="utf-8", errors="replace")
        placeholders = find_placeholders(text)
        if placeholders:
            preview = ", ".join(placeholders[:5]) + (" ..." if len(placeholders) > 5 else "")
            errors.append(f"Unresolved template placeholder in {path.relative_to(root)}: {preview}")
    waves = root / "docs" / "waves" / "README.md"
    if waves.exists():
        text = waves.read_text(encoding="utf-8", errors="replace")
        if "⏸ gated · 🟡 approved & in progress · ✅ done & signed off" not in text:
            errors.append("Wave status legend is missing or changed")
    return errors


def command_doctor(repo: Path) -> dict[str, Any]:
    root = repository_root(repo)
    config = load_config(repo)
    canonical = load_canonical(repo) if config else None
    return {
        **policy.evaluate_policy(root),
        "ok": True,
        "python": sys.version.split()[0],
        "git": git(repo, "--version"),
        "repository": str(root),
        "repository_id": repo_identity(repo),
        "common_git_dir": str(common_git_dir(repo)),
        "configured": config is not None,
        "config_schema": config.get("schema_version") if config else None,
        "canonical_worktree": canonical.get("canonical_worktree") if canonical else None,
        "hooks_enabled": bool(config and config.get("hooks_enabled")),
        "mode": "resume" if state_path(repo, "run-state.json").exists() else "install",
    }


def command_set_canonical(repo: Path, target: str) -> dict[str, Any]:
    load_config(repo, required=True)
    candidate = Path(target).expanduser().resolve()
    listed = {Path(item["path"]).resolve() for item in parse_worktrees(repo)}
    if candidate not in listed:
        raise GovernanceError(f"Not a registered worktree of this repository: {candidate}", EXIT_USAGE)
    with state_lock(repo):
        record = save_canonical(repo, candidate, "owner")
        registry = inventory(repo)
        atomic_write_json(state_path(repo, "registry.json"), registry)
        start_or_refresh_run(repo, registry)
    return {
        "canonical_worktree": record["canonical_worktree"],
        "canonical_branch": record["canonical_branch"],
        "canonical_head": registry["canonical_head"],
    }


def command_status(repo: Path) -> dict[str, Any]:
    config = load_config(repo)
    run = read_json(state_path(repo, "run-state.json"))
    registry = read_json(state_path(repo, "registry.json"))
    resolutions = read_json(state_path(repo, "resolutions.json"), {"records": []})
    return {
        **policy.evaluate_policy(repository_root(repo)),
        "configured": config is not None,
        "enabled": bool(config and config.get("enabled")),
        "hooks_enabled": bool(config and config.get("hooks_enabled")),
        "run": run,
        "registry_summary": None
        if registry is None
        else {
            "canonical_worktree": registry.get("canonical_worktree"),
            "canonical_branch": registry.get("canonical_branch"),
            "canonical_head": registry.get("canonical_head"),
            "worktree_count": len(registry.get("worktrees", [])),
            "dirty_worktree_count": sum(1 for item in registry.get("worktrees", []) if item.get("dirty")),
            "scanned_at": registry.get("scanned_at"),
        },
        "resolution_summary": {
            "total": len(resolutions.get("records", [])),
            "unresolved": len(unresolved_records(repo)),
        },
    }


def command_discover(repo: Path) -> dict[str, Any]:
    with state_lock(repo):
        ensure_config(repo)
        initialize_canonical(repo)
        registry = inventory(repo)
        packet = discovery_packet(repo, registry)
        atomic_write_json(state_path(repo, "registry.json"), registry)
        atomic_write_json(state_path(repo, "discovery.json"), packet)
        run = start_or_refresh_run(repo, registry)
    return {
        "registry": str(state_path(repo, "registry.json")),
        "discovery_packet": str(state_path(repo, "discovery.json")),
        "worktree_count": len(registry["worktrees"]),
        "dirty_worktree_count": sum(1 for item in registry["worktrees"] if item["dirty"]),
        "mode": packet["mode"],
        "run_id": run["run_id"],
    }


def command_reconcile(repo: Path) -> dict[str, Any]:
    with state_lock(repo):
        load_config(repo, required=True)
        registry = inventory(repo)
        snapshots = capture_inventory(repo, registry)
        atomic_write_json(state_path(repo, "registry.json"), registry)
        resolutions = build_resolutions(repo, registry, snapshots)
        run = start_or_refresh_run(repo, registry)
        unresolved = unresolved_records(repo)
        if unresolved:
            run["phase"] = "resolution"
            run["next_action"] = "Obtain owner choices for unresolved resolution records"
        elif run.get("phase") in {"discovery", "resolution"}:
            # Only advance out of the early phases; a hook-triggered reconcile during
            # planning or later must not rewind progress recorded via `phase`.
            run["phase"] = "intent"
            run["next_action"] = "Ratify blocking intent and author canonical decisions"
        atomic_write_json(state_path(repo, "run-state.json"), run)
    return {
        "snapshots_created": sum(1 for item in snapshots.values() if item["_created"]),
        "snapshots_reused": sum(1 for item in snapshots.values() if not item["_created"]),
        "incomplete_snapshots": sum(1 for item in snapshots.values() if item["coverage"]["status"] != "complete"),
        "unavailable_worktrees": sum(1 for item in registry["worktrees"] if item["availability"] != "available"),
        "recovery_errors": recovery_errors(repo),
        "resolution_count": len(resolutions["records"]),
        "unresolved": len(unresolved_records(repo)),
        "resolution_file": str(state_path(repo, "resolutions.json")),
    }


def command_resolve(repo: Path, record_id: str, choice: str, note: str, recovery_reference: str | None = None) -> dict[str, Any]:
    allowed = {"keep-canonical", "adopt", "combine", "defer", "obsolete", "return-to-agent"}
    if choice not in allowed:
        raise GovernanceError(f"Unsupported resolution choice: {choice}", EXIT_USAGE)
    if not note.strip():
        raise GovernanceError("A resolution note is required", EXIT_USAGE)
    with state_lock(repo):
        path = state_path(repo, "resolutions.json")
        resolutions = read_json(path, {"records": []})
        target = next((item for item in resolutions["records"] if item.get("id") == record_id), None)
        if target is None:
            raise GovernanceError(f"Unknown resolution ID: {record_id}", EXIT_USAGE)
        if target["kind"] == "unavailable-worktree":
            raise GovernanceError("Restore the unavailable worktree and reconcile; its unknown content cannot be waived", EXIT_GATE)
        fresh = inventory(repo)
        if target["kind"] != "incomplete-recovery":
            if any(not item.get("content_verifiable", True) for item in fresh["worktrees"] if item["path"] in target["worktrees"]):
                raise GovernanceError("Current content cannot be fingerprinted; restore readable supported files and reconcile", EXIT_GATE)
            if (target.get("retired_at") or not target.get("review_fingerprint")
                    or resolution_version(target, fresh) != target["review_fingerprint"]):
                raise GovernanceError("Reviewed content changed or record is historical; reconcile and review the current version", EXIT_GATE)
        reference = target.get("alternative_recovery")
        if recovery_reference:
            if target["kind"] != "incomplete-recovery":
                raise GovernanceError("Use --recovery-ref on the incomplete-recovery record", EXIT_USAGE)
            reference = alternative_recovery(repo, recovery_reference)
        if target["kind"] == "incomplete-recovery" and choice in {"keep-canonical", "defer", "obsolete"}:
            if not reference or alternative_recovery(repo, reference["path"]) != reference:
                raise GovernanceError("Incomplete recovery requires --recovery-ref to an owner-attested backup file", EXIT_GATE)
        if (target.get("choice") == choice and target.get("note") == note.strip()
                and target.get("alternative_recovery") == reference):
            return {"id": record_id, "choice": choice, "status": target["status"]}
        if target.get("choice"):
            target.setdefault("decision_history", []).append({key: target.get(key) for key in
                ("choice", "note", "status", "resolved_at", "updated_at", "alternative_recovery")})
        if reference:
            target["alternative_recovery"] = reference
        target["choice"] = choice
        target["note"] = note.strip()
        # adopt/combine/return-to-agent describe work that still has to happen; they stay
        # pending (and block closure) until reconcile observes the variant is gone.
        status_by_choice = {
            "keep-canonical": "resolved",
            "defer": "deferred",
            "obsolete": "obsolete",
            "adopt": "pending",
            "combine": "pending",
            "return-to-agent": "pending",
        }
        target["status"] = status_by_choice[choice]
        if target["status"] != "pending":
            target["resolved_at"] = utc_now()
        else:
            target.pop("resolved_at", None)
        target["updated_at"] = utc_now()
        resolutions["updated_at"] = utc_now()
        atomic_write_json(path, resolutions)
    return {"id": record_id, "choice": choice, "status": target["status"]}


def command_validate(repo: Path, requested_policy: str = "auto") -> dict[str, Any]:
    errors: list[str] = []
    warnings: list[str] = []
    config = load_config(repo, required=True)
    assert config is not None
    registry = read_json(state_path(repo, "registry.json"))
    run = read_json(state_path(repo, "run-state.json"))
    if registry is None:
        errors.append("Missing worktree registry; run discover")
    if run is None:
        errors.append("Missing run state; run discover")
    if registry is not None:
        canonical = Path(registry.get("canonical_worktree", ""))
        if not canonical.is_dir():
            errors.append("Canonical worktree is unavailable")
        else:
            live_head = current_head(canonical)
            if live_head != registry.get("canonical_head"):
                errors.append("Canonical HEAD changed after the last inventory")
        artifact_errors, artifact_warnings = validate_artifacts(
            canonical, str(config.get("project_slug") or canonical.name), requested_policy
        )
        errors.extend(artifact_errors)
        warnings.extend(artifact_warnings)
        fresh = inventory(repo)
        for item in fresh["worktrees"]:
            if item["availability"] != "available" or not item.get("content_verifiable", True):
                errors.append(f"Worktree content is unavailable or unverifiable: {item['path']}")
        resolutions = read_json(state_path(repo, "resolutions.json"), {"records": []})
        for record in resolutions["records"]:
            if not record.get("retired_at") and record["kind"] not in {"incomplete-recovery", "unavailable-worktree"}:
                if record.get("review_fingerprint") and resolution_version(record, fresh) != record["review_fingerprint"]:
                    errors.append(f"Reviewed content changed for {record['id']}; reconcile")
        for identifier in registry.get("snapshot_ids", []):
            if not (state_dir(repo) / "snapshots" / f"{identifier}.json").is_file():
                errors.append(f"Missing current snapshot manifest: {identifier}")
    errors.extend(recovery_errors(repo))
    unresolved = unresolved_records(repo)
    policy_result = policy.evaluate_policy(repository_root(repo), requested=requested_policy)
    stage = stages.inspect(sys.modules[__name__], repo, policy_result["policy_version"] == policy.CURRENT_POLICY)
    stage_errors = [f"[{d['code']}] {d['message']}" for d in stage["diagnostics"]]
    errors.extend(stage_errors)
    artifact_valid = not [error for error in errors if not any(
        error == message or error.endswith(": " + message) for message in policy_result["policy_errors"])]
    errors.extend(policy_result["policy_errors"])
    return {
        **policy_result,
        "artifact_valid": artifact_valid,
        "stage": stage,
        "stage_valid": stage["valid"],
        "stage_errors": stage_errors,
        "valid": not errors,
        "errors": errors,
        "warnings": warnings,
        "unresolved_resolution_count": len(unresolved),
        "unresolved_resolution_ids": [item["id"] for item in unresolved],
    }


def validate_artifacts(root: Path, project_slug: str, requested_policy: str = "auto") -> tuple[list[str], list[str]]:
    """Inspect artifacts independently of machine-local initialization."""
    errors = validate_generated_docs(root)
    warnings: list[str] = []
    docs = root / "docs"
    planning_started = (docs / "waves" / "README.md").exists()
    specification_started = any(docs.glob("*-FSD.md")) or any(docs.glob("*-TSD.md")) or planning_started
    if specification_started:
        spec_arguments = ["--repo", str(root), "--project", project_slug, "--policy", requested_policy]
        spec_errors, spec_warnings = run_sibling_validator(
            "spec-chain", "validate_spec.py", [*spec_arguments, "--mode", "governance"], root, "Specification"
        )
        errors.extend(spec_errors)
        warnings.extend(spec_warnings)
        trace_errors, _ = run_sibling_validator(
            "spec-chain", "trace_chain.py", spec_arguments, root, "Trace", error_key="breaks"
        )
        errors.extend(trace_errors)
    if planning_started:
        plan_errors, plan_warnings = run_sibling_validator(
            "plan-waves-slices", "validate_plan.py", ["--repo", str(root), "--mode", "governance", "--policy", requested_policy], root, "Planning"
        )
        errors.extend(plan_errors)
        warnings.extend(plan_warnings)
    return errors, warnings


def command_audit(repo: Path) -> dict[str, Any]:
    """Fresh read-only inspection, not discovery, reconciliation or acceptance."""
    root = repository_root(repo)
    policy_result = policy.evaluate_policy(root)
    errors = list(policy_result["policy_errors"])
    warnings: list[str] = []
    config = None
    fresh = None
    validation = None
    try:
        config = load_config(repo)
        fresh = inventory(repo)
        canonical = Path(fresh["canonical_worktree"])
        if config:
            artifact_errors, artifact_warnings = validate_artifacts(
                canonical, str(config.get("project_slug") or canonical.name)
            )
            errors.extend(artifact_errors)
            warnings.extend(artifact_warnings)
            if state_path(repo, "run-state.json").exists():
                validation = command_validate(repo)
                errors.extend(validation["errors"])
                warnings.extend(validation["warnings"])
            else:
                errors.extend(recovery_errors(repo))
                warnings.append("No local run state; audit does not initialize it or establish completion")
        else:
            warnings.append("Governance is not initialized; no governed artifact set has been selected")
        for item in fresh["worktrees"]:
            if item["availability"] != "available":
                errors.append(f"Worktree is unavailable: {item['path']}")
        if config and config["schema_version"] in LEGACY_SCHEMA_VERSIONS:
            warnings.append("Legacy schema 2 is read without identity migration; use upgrade explicitly")
        unresolved = unresolved_records(repo)
        if unresolved:
            warnings.append("Unresolved worktree dispositions remain; audit does not reconcile them")
    except (GovernanceError, OSError) as exc:
        errors.append(str(exc))
        unresolved = []
    return {
        **policy_result,
        "valid": not errors,
        "errors": list(dict.fromkeys(errors)),
        "warnings": list(dict.fromkeys(warnings)),
        "configured": config is not None,
        "config_schema": config.get("schema_version") if config else None,
        "inventory": fresh,
        "runtime_validation": validation,
        "unresolved_resolution_ids": [item["id"] for item in unresolved],
        "acceptance_checked": False,
        "read_only": True,
    }


def command_upgrade(repo: Path, *, apply: bool, target_policy: str) -> dict[str, Any]:
    """Explicit metadata upgrade. Never fabricate missing approval/evidence."""
    audit = command_audit(repo)
    target = policy.CURRENT_POLICY if target_policy == "current" else policy.LEGACY_POLICY
    blockers: list[str] = []
    for path in (config_path(repo), config_path(repo).parent, canonical_state_path(repo),
                 state_dir(repo), state_dir(repo) / "upgrades"):
        if path.is_symlink():
            blockers.append(f"Metadata upgrade refuses a symlink target; resolve ownership first: {path}")
    try:
        config = load_config(repo, required=True)
    except GovernanceError as exc:
        config = None
        blockers.append(str(exc))
    if target == policy.CURRENT_POLICY and not policy.CURRENT_POLICY_READY:
        blockers.append("Current policy 2 is not released; finish enforcement and migration gates before adoption")
    if config and target < config.get("policy_version", policy.LEGACY_POLICY):
        blockers.append("Upgrade cannot downgrade an existing project policy")
    if target == policy.CURRENT_POLICY:
        blockers.extend(audit["errors"])
    changed = bool(config and (config["schema_version"] != SCHEMA_VERSION or config.get("policy_version") != target))
    changes = []
    if config and config["schema_version"] != SCHEMA_VERSION:
        changes.append("Migrate owned config identity fields to schema 3; preserve local canonical selection")
    if config and config.get("policy_version") != target:
        changes.append(f"Record explicit policy_version {target}")
    result = {
        "valid": not blockers,
        "errors": list(dict.fromkeys(blockers)),
        "warnings": audit["warnings"],
        "audit": audit,
        "target_policy_version": target,
        "changes": changes,
        "applied": False,
        "changed": False,
        "read_only": not apply,
    }
    if not apply or blockers:
        if blockers:
            result["read_only"] = True
        return result
    if not changed:
        result.update(applied=True, read_only=True)
        return result
    assert config is not None
    before_config = config_path(repo).read_bytes()
    before_config_mode = config_path(repo).stat().st_mode & 0o777
    if json.loads(before_config) != config:
        raise GovernanceError("Governance config changed during upgrade; preview again", EXIT_GATE)
    before_canonical = canonical_state_path(repo).read_bytes() if canonical_state_path(repo).exists() else None
    canonical = load_canonical(repo)
    upgraded = dict(config)
    upgraded.update(schema_version=SCHEMA_VERSION, policy_version=target, suite_version=SUITE_VERSION,
                    repository_id=repo_identity(repo), migrated_at=utc_now())
    if config["schema_version"] in LEGACY_SCHEMA_VERSIONS:
        upgraded.pop("canonical_worktree", None)
        upgraded.pop("canonical_branch", None)
        upgraded.setdefault("project_slug", default_project_slug(repo))
    # Snapshot exact original bytes, including unknown project extensions. The hash
    # names one migration input, not a mutable 'latest backup'.
    identity = hashlib.sha256(before_config + b"\0" + (before_canonical or b"")).hexdigest()
    backup = state_dir(repo) / "upgrades" / identity
    with state_lock(repo):
        live_canonical = canonical_state_path(repo).read_bytes() if canonical_state_path(repo).exists() else None
        if (config_path(repo).read_bytes() != before_config or live_canonical != before_canonical
                or config_path(repo).stat().st_mode & 0o777 != before_config_mode):
            raise GovernanceError("Governance metadata changed during upgrade; preview again", EXIT_GATE)
        if backup.exists() or backup.is_symlink():
            raise GovernanceError(f"Migration backup already exists; inspect recovery before retrying: {backup}", EXIT_GATE)
        atomic_write_bytes(backup / "config.json", before_config)
        if before_canonical is not None:
            atomic_write_bytes(backup / "canonical.json", before_canonical)
        atomic_write_json(backup / "manifest.json", {
            "created_at": utc_now(), "config_schema_before": config["schema_version"],
            "policy_version_before": config.get("policy_version", policy.LEGACY_POLICY),
            "target_policy_version": target, "canonical_existed": before_canonical is not None,
            "config_sha256": hashlib.sha256(before_config).hexdigest(),
            "config_mode": before_config_mode,
            "canonical_sha256": hashlib.sha256(before_canonical).hexdigest() if before_canonical is not None else None,
        })
        if before_canonical is None and config["schema_version"] in LEGACY_SCHEMA_VERSIONS:
            atomic_write_json(canonical_state_path(repo), canonical)
        atomic_write_json(config_path(repo), upgraded, mode=before_config_mode)
    result.update(applied=True, changed=True, backup=str(backup))
    return result


def run_sibling_validator(
    skill: str,
    script: str,
    arguments: list[str],
    cwd: Path,
    label: str,
    *,
    error_key: str = "errors",
) -> tuple[list[str], list[str]]:
    """Return (errors, warnings) from a sibling skill's validator."""
    validator = find_skill_root().parent / skill / "scripts" / script
    if not validator.is_file():
        return [f"{label} validator is unavailable: {validator}"], []
    result = run_process(
        [sys.executable, str(validator), *arguments, "--json"],
        cwd,
        check=False,
        text=True,
    )
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError:
        return [f"{label} validator returned invalid JSON"], []
    errors = [f"{label}: {message}" for message in payload.get(error_key, [])]
    warnings = [f"{label}: {message}" for message in payload.get("warnings", [])]
    return errors, warnings


def command_resume(repo: Path) -> dict[str, Any]:
    load_config(repo, required=True)
    run = read_json(state_path(repo, "run-state.json"))
    if run is None:
        raise GovernanceError("No active governance run; run discover", EXIT_VALIDATION)
    return {
        "run_id": run.get("run_id"),
        "status": run.get("status"),
        "phase": run.get("phase"),
        "next_action": run.get("next_action"),
        "canonical_worktree": run.get("canonical_worktree"),
        "canonical_head": run.get("canonical_head"),
    }


def command_close_stage(repo: Path, approved: bool, approval_reference: str | None = None) -> dict[str, Any]:
    if not approved:
        raise GovernanceError("Stage closure requires explicit --owner-approved", EXIT_GATE)
    with state_lock(repo):
        load_config(repo, required=True)
        run = read_json(state_path(repo, "run-state.json"))
        if run and run.get("stage_required") and run.get("status") == "closed":
            return {"closed": True, "already_closed": True, "run_id": run["run_id"],
                    "stage_completion": run.get("stage_completion")}
        close_approval = None
        if run and (run.get("stage_required") or run.get("stage_id")):
            if not approval_reference:
                raise GovernanceError("Stage closure requires --approval-ref to the owner's sign-off record", EXIT_GATE)
            try:
                close_approval = stages.approval_record(sys.modules[__name__], repo, approval_reference)
            except (OSError, ValueError) as exc:
                raise GovernanceError(str(exc), EXIT_GATE) from exc
        fresh = inventory(repo)
        snapshots = capture_inventory(repo, fresh)
        atomic_write_json(state_path(repo, "registry.json"), fresh)
        # Rebuild from the fresh inventory so closure reflects worktrees dirtied since the
        # last reconcile and auto-resolves pending variants that have since been cleaned.
        build_resolutions(repo, fresh, snapshots)
        validation = command_validate(repo)
        blockers = list(validation["errors"])
        if validation["unresolved_resolution_count"]:
            blockers.append("Unresolved worktree resolution records remain")
        if blockers:
            raise GovernanceError("; ".join(blockers), EXIT_GATE)
        after = inventory(repo)
        before_versions = {item["path"]: item["content_fingerprint"] for item in fresh["worktrees"]}
        after_versions = {item["path"]: item["content_fingerprint"] for item in after["worktrees"]}
        if before_versions != after_versions:
            raise GovernanceError("Worktree changed while closing the stage; reconcile again", EXIT_GATE)
        run = read_json(state_path(repo, "run-state.json"))
        if run is None:
            raise GovernanceError("No active run to close", EXIT_VALIDATION)
        if close_approval is not None:
            final_stage = stages.inspect(sys.modules[__name__], repo, True)
            if not final_stage["valid"]:
                raise GovernanceError("; ".join(d["message"] for d in final_stage["diagnostics"]), EXIT_GATE)
            if stages.approval_record(sys.modules[__name__], repo, approval_reference) != close_approval:
                raise GovernanceError("Owner sign-off changed during closure", EXIT_GATE)
            completion = {"stage_id": run["stage_id"], "contract_sha256": run["stage_contract_sha256"],
                          "subject": final_stage["subject"], "evidence": final_stage["evidence"],
                          "owner_approval": close_approval, "closed_at": utc_now()}
            directory, _ = stages.load_stage(sys.modules[__name__], repo, run)
            previous = read_json(directory / "closure.json")
            if previous:
                if any(previous.get(key) != completion[key] for key in completion if key != "closed_at"):
                    raise GovernanceError("Interrupted closure record differs; inspect it before retrying", EXIT_GATE)
                completion = previous
            else:
                stages.publish(sys.modules[__name__], directory / "closure.json", completion)
            run["stage_completion"] = completion
        run.update(
            {
                "status": "closed",
                "owner_close_approved": True,
                "closed_at": utc_now(),
                "updated_at": utc_now(),
                "next_action": "No active stage",
            }
        )
        atomic_write_json(state_path(repo, "run-state.json"), run)
    return {"closed": True, "run_id": run["run_id"], "canonical_head": fresh["canonical_head"]}


def command_check_stage(repo: Path, requested_policy: str = "auto") -> dict[str, Any]:
    selected = policy.evaluate_policy(repository_root(repo), requested=requested_policy)
    report = stages.inspect(sys.modules[__name__], repo, selected["policy_version"] == policy.CURRENT_POLICY)
    return {**selected, "stage": report, "stage_valid": report["valid"],
            "valid": report["valid"] and not selected["policy_errors"]}


def find_skill_root() -> Path:
    return Path(__file__).resolve().parent.parent


def merge_hook_file(path: Path, platform: str, command: str) -> None:
    existing = read_json(path, {})
    if not isinstance(existing, dict):
        raise GovernanceError(f"Hook configuration must be a JSON object: {path}", EXIT_VALIDATION)
    if platform == "cursor":
        existing.setdefault("version", 1)
        hooks = existing.setdefault("hooks", {})
        specs = {
            "sessionStart": {"command": f"{command} session-start", "timeout": 10},
            "subagentStart": {"command": f"{command} subagent-start", "timeout": 10},
            "subagentStop": {"command": f"{command} subagent-stop", "timeout": 10},
            # No matcher: Cursor tool-type names are not verified, so the adapter
            # filters on the payload (command / file path) instead.
            "preToolUse": {
                "command": f"{command} pre-tool-use",
                "timeout": 10,
                "failClosed": True,
            },
            "postToolUse": {
                "command": f"{command} post-tool-use",
                "matcher": "Write|Edit",
                "timeout": 10,
            },
            "stop": {
                "command": f"{command} stop",
                "timeout": 10,
                "loop_limit": 1,
            },
            "sessionEnd": {"command": f"{command} session-end", "timeout": 10},
        }
    else:
        hooks = existing.setdefault("hooks", {})
        specs = {
            "SessionStart": {
                "hooks": [{"type": "command", "command": f"{command} session-start", "timeout": 10}]
            },
            "SubagentStart": {
                "hooks": [{"type": "command", "command": f"{command} subagent-start", "timeout": 10}]
            },
            "SubagentStop": {
                "hooks": [{"type": "command", "command": f"{command} subagent-stop", "timeout": 10}]
            },
            "PreToolUse": {
                "matcher": "Edit|Write|Bash",
                "hooks": [{"type": "command", "command": f"{command} pre-tool-use", "timeout": 10}]
            },
            "PostToolUse": {
                "matcher": "Edit|Write",
                "hooks": [{"type": "command", "command": f"{command} post-tool-use", "timeout": 10}]
            },
            "Stop": {
                "hooks": [{"type": "command", "command": f"{command} stop", "timeout": 10}]
            },
            "SessionEnd": {
                "hooks": [{"type": "command", "command": f"{command} session-end", "timeout": 10}]
            },
        }
    for event, spec in specs.items():
        entries = hooks.setdefault(event, [])
        if isinstance(entries, dict):
            entries = [entries]
            hooks[event] = entries
        target = hook_entry_command(platform, spec)
        for index, entry in enumerate(entries):
            if isinstance(entry, dict) and hook_entry_command(platform, entry) == target:
                # Same governance command already registered: replace it so upgraded
                # specs never accumulate duplicates.
                entries[index] = spec
                break
        else:
            entries.append(spec)
    atomic_write_json(path, existing, mode=0o644)


def hook_entry_command(platform: str, entry: dict[str, Any]) -> str | None:
    if platform == "cursor":
        value = entry.get("command")
        return str(value) if value else None
    nested = entry.get("hooks")
    if isinstance(nested, list) and nested and isinstance(nested[0], dict):
        value = nested[0].get("command")
        return str(value) if value else None
    return None


def command_install_hooks(repo: Path) -> dict[str, Any]:
    config = load_config(repo, required=True)
    assert config is not None
    root = repository_root(repo)
    skill_root = find_skill_root()
    cursor_wrapper = root / ".cursor" / "hooks" / "governance-hook.py"
    claude_wrapper = root / ".claude" / "hooks" / "governance-hook.py"
    source_cursor = skill_root / "hooks" / "cursor" / "governance-hook.py"
    source_claude = skill_root / "hooks" / "claude-code" / "governance-hook.py"
    for source, destination in [(source_cursor, cursor_wrapper), (source_claude, claude_wrapper)]:
        if not source.exists():
            raise GovernanceError(f"Missing hook adapter asset: {source}", EXIT_VALIDATION)
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination)
        destination.chmod(0o755)
    merge_hook_file(
        root / ".cursor" / "hooks.json",
        "cursor",
        "python3 .cursor/hooks/governance-hook.py",
    )
    merge_hook_file(
        root / ".claude" / "settings.json",
        "claude",
        "python3 .claude/hooks/governance-hook.py",
    )
    config["hooks_enabled"] = True
    config["hooks_installed_at"] = utc_now()
    atomic_write_json(config_path(repo), config, mode=0o644)
    return {
        "installed": True,
        "cursor": str(root / ".cursor" / "hooks.json"),
        "claude_code": str(root / ".claude" / "settings.json"),
    }


def neutral_hook_decision(repo: Path, event: str, payload: dict[str, Any]) -> dict[str, Any]:
    config = load_config(repo)
    if config is None or not config.get("enabled") or not config.get("hooks_enabled"):
        return {"permission": "allow", "reason": "governance-disabled"}
    if event in {"subagent-stop", "session-end"}:
        try:
            result = command_reconcile(repo)
            if result["incomplete_snapshots"] or result["unavailable_worktrees"] or result["recovery_errors"]:
                return {"permission": "allow", "reason": "snapshot-warning: recovery is incomplete; inspect resolutions before closure"}
            return {"permission": "allow", "reason": "unfinished-work-snapshotted"}
        except GovernanceError as exc:
            return {"permission": "allow", "reason": f"snapshot-warning: {exc}"}
    if event in {"session-start", "post-tool-use", "subagent-start"}:
        try:
            command_discover(repo)
            return {"permission": "allow", "reason": "inventory-refreshed"}
        except GovernanceError as exc:
            return {"permission": "allow", "reason": f"inventory-warning: {exc}"}
    if event == "pre-tool-use":
        command = str(payload.get("command") or payload.get("tool_input", {}).get("command") or "")
        destructive = re.search(
            r"\bgit\s+(?:reset\s+--hard|clean\s+-[a-zA-Z]*f|checkout\s+--|push\s+--force|rebase|merge)\b",
            command,
        )
        if destructive:
            return {"permission": "ask", "reason": "Governance requires owner review for destructive Git operations"}
        target = (
            payload.get("path")
            or payload.get("file_path")
            or payload.get("tool_input", {}).get("path")
            or payload.get("tool_input", {}).get("file_path")
        )
        if target:
            registry = read_json(state_path(repo, "registry.json"), {"worktrees": []})
            current = repository_root(repo)
            try:
                relative = str(Path(target).resolve().relative_to(current))
            except (ValueError, OSError):
                relative = str(target)
            owners = [
                item["path"]
                for item in registry.get("worktrees", [])
                if Path(item["path"]).resolve() != current and relative in item.get("dirty_paths", [])
            ]
            if owners:
                return {
                    "permission": "ask",
                    "reason": f"Path is dirty in another worktree; reconcile before editing: {relative}",
                }
        return {"permission": "allow", "reason": "no-collision"}
    if event == "stop":
        return stop_decision(repo, payload)
    return {"permission": "allow", "reason": "event-not-gated"}


def stop_decision(repo: Path, payload: dict[str, Any]) -> dict[str, Any]:
    # Stop marks the end of a turn, not stage closure. Only close-stage gates; here we
    # self-heal a stale inventory and surface concrete warnings once.
    if payload.get("stop_hook_active"):
        return {"permission": "allow", "reason": "governance-stop-hook-active"}
    warnings: list[str] = []
    try:
        registry = read_json(state_path(repo, "registry.json"))
        if registry is not None:
            canonical = Path(registry.get("canonical_worktree", ""))
            if canonical.is_dir() and current_head(canonical) != registry.get("canonical_head"):
                command_discover(repo)
    except GovernanceError as exc:
        warnings.append(f"inventory refresh failed: {exc}")
    try:
        validation = command_validate(repo)
    except GovernanceError as exc:
        warnings.append(f"validation unavailable: {exc}")
    else:
        warnings.extend(validation["errors"])
        if validation["unresolved_resolution_ids"]:
            warnings.append(
                "unresolved worktree resolutions: " + ", ".join(validation["unresolved_resolution_ids"])
            )
    if warnings:
        return {"permission": "allow", "reason": "governance-warning: " + "; ".join(warnings)}
    return {"permission": "allow", "reason": "governance-valid"}


def command_hook(repo: Path, event: str) -> dict[str, Any]:
    try:
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict):
            payload = {}
    except json.JSONDecodeError:
        payload = {}
    return neutral_hook_decision(repo, event, payload)


def render_result(value: dict[str, Any], as_json: bool) -> None:
    if as_json:
        print(json.dumps(value, sort_keys=True))
        return
    for key, item in value.items():
        if isinstance(item, (dict, list)):
            print(f"{key}: {json.dumps(item, sort_keys=True)}")
        else:
            print(f"{key}: {item}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="governancectl")
    parser.add_argument("--repo", default=".", help="Path to a Git worktree")
    parser.add_argument("--json", action="store_true", help="Emit one JSON object")
    subparsers = parser.add_subparsers(dest="command", required=True)
    for name in ["doctor", "status", "audit", "discover", "reconcile", "resume", "install-hooks"]:
        subparsers.add_parser(name)
    for name in ["validate", "check-stage"]:
        subparsers.add_parser(name).add_argument("--policy", choices=["auto", "legacy", "current"], default="auto")
    freeze_parser = subparsers.add_parser("freeze-stage")
    freeze_parser.add_argument("--contract", required=True)
    freeze_parser.add_argument("--owner-approved", action="store_true")
    freeze_parser.add_argument("--approval-ref", required=True)
    check_parser = subparsers.add_parser("run-check")
    check_parser.add_argument("--id", required=True)
    cancel_parser = subparsers.add_parser("cancel-stage")
    cancel_parser.add_argument("--owner-approved", action="store_true")
    cancel_parser.add_argument("--approval-ref", required=True)
    cancel_parser.add_argument("--reason", required=True)
    resolve_note_parser = subparsers.add_parser("resolve-note")
    resolve_note_parser.add_argument("--id", required=True)
    resolve_note_parser.add_argument("--decision", required=True)
    resolve_note_parser.add_argument("--note", required=True)
    resolve_note_parser.add_argument("--owner-approved", action="store_true")
    upgrade_parser = subparsers.add_parser("upgrade")
    upgrade_action = upgrade_parser.add_mutually_exclusive_group(required=True)
    upgrade_action.add_argument("--dry-run", action="store_true")
    upgrade_action.add_argument("--apply", action="store_true")
    upgrade_parser.add_argument("--policy", choices=["legacy", "current"], default="current")
    resolve_parser = subparsers.add_parser("resolve")
    resolve_parser.add_argument("--id", required=True, dest="record_id")
    resolve_parser.add_argument(
        "--choice",
        required=True,
        choices=["keep-canonical", "adopt", "combine", "defer", "obsolete", "return-to-agent"],
    )
    resolve_parser.add_argument("--note", required=True)
    resolve_parser.add_argument("--recovery-ref", dest="recovery_reference", help="Owner-attested local backup file for incomplete recovery")
    close_parser = subparsers.add_parser("close-stage")
    close_parser.add_argument("--owner-approved", action="store_true")
    close_parser.add_argument("--approval-ref", dest="approval_reference")
    canonical_parser = subparsers.add_parser("set-canonical")
    canonical_parser.add_argument("--path", required=True, dest="canonical_path")
    note_parser = subparsers.add_parser("note")
    note_parser.add_argument("--kind", required=True, choices=sorted(NOTE_KINDS))
    note_parser.add_argument("--text", required=True)
    note_parser.add_argument("--evidence", default=None)
    note_parser.add_argument("--provenance", default=None, choices=PROVENANCE)
    note_parser.add_argument("--evidence-class", default=None, choices=EVIDENCE_CLASSES, dest="evidence_class")
    phase_parser = subparsers.add_parser("phase")
    phase_parser.add_argument("phase", choices=PHASES)
    phase_parser.add_argument("--next-action", default=None, dest="next_action")
    hook_parser = subparsers.add_parser("hook")
    hook_parser.add_argument(
        "event",
        choices=[
            "session-start",
            "subagent-start",
            "subagent-stop",
            "pre-tool-use",
            "post-tool-use",
            "stop",
            "session-end",
        ],
    )
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        repo = resolve_repo(args.repo)
        if args.command not in {"doctor", "status", "audit", "validate", "resume", "upgrade", "check-stage"}:
            readiness = policy.evaluate_policy(repository_root(repo))
            if readiness["policy_errors"]:
                raise GovernanceError("; ".join(readiness["policy_errors"]), EXIT_GATE)
        handlers = {
            "doctor": lambda: command_doctor(repo),
            "status": lambda: command_status(repo),
            "audit": lambda: command_audit(repo),
            "upgrade": lambda: command_upgrade(repo, apply=args.apply, target_policy=args.policy),
            "discover": lambda: command_discover(repo),
            "reconcile": lambda: command_reconcile(repo),
            "validate": lambda: command_validate(repo, args.policy),
            "check-stage": lambda: command_check_stage(repo, args.policy),
            "freeze-stage": lambda: stages.freeze(sys.modules[__name__], repo, args.contract, args.owner_approved, args.approval_ref),
            "run-check": lambda: stages.run_check(sys.modules[__name__], repo, args.id),
            "cancel-stage": lambda: stages.cancel(sys.modules[__name__], repo, args.owner_approved, args.approval_ref, args.reason),
            "resolve-note": lambda: stages.resolve_note(sys.modules[__name__], repo, args.id, args.decision, args.note, args.owner_approved),
            "resume": lambda: command_resume(repo),
            "install-hooks": lambda: command_install_hooks(repo),
            "resolve": lambda: command_resolve(repo, args.record_id, args.choice, args.note, args.recovery_reference),
            "close-stage": lambda: command_close_stage(repo, args.owner_approved, args.approval_reference),
            "set-canonical": lambda: command_set_canonical(repo, args.canonical_path),
            "note": lambda: command_note(
                repo, args.kind, args.text, args.evidence, args.provenance, args.evidence_class
            ),
            "phase": lambda: command_phase(repo, args.phase, args.next_action),
            "hook": lambda: command_hook(repo, args.event),
        }
        result = handlers[args.command]()
        render_result(result, args.json)
        if args.command in {"validate", "audit", "check-stage"} and not result["valid"]:
            return EXIT_VALIDATION
        if args.command == "run-check" and not result["passed"]:
            return EXIT_VALIDATION
        if args.command == "upgrade" and not result["valid"]:
            return EXIT_GATE
        if args.command == "reconcile" and (result["unresolved"] or result["recovery_errors"]):
            return EXIT_GATE
        return 0
    except (GovernanceError, OSError, ValueError) as exc:
        exit_code = exc.exit_code if isinstance(exc, GovernanceError) else EXIT_GATE if isinstance(exc, ValueError) else EXIT_VALIDATION
        if args.json:
            print(json.dumps({"error": str(exc), "exit_code": exit_code}, sort_keys=True))
        else:
            print(f"error: {exc}", file=sys.stderr)
        return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
