{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "python3 ${CURSOR_PLUGIN_ROOT}/hooks/guard.py pre-tool-use",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python3 ${CURSOR_PLUGIN_ROOT}/hooks/guard.py stop",
        "timeout": 20,
        "loop_limit": 1
      }
    ]
  }
}
